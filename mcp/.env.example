# Backend API this MCP server talks to.
NOURISHIBLE_API_URL=http://localhost:4000

# Must match the redirect_uris registered for this client_id in the
# backend's oauth_clients table (see backend/src/db.ts seed data).
NOURISHIBLE_OAUTH_CLIENT_ID=claude-mcp
NOURISHIBLE_MCP_CALLBACK_PORT=6274

# Where the login token is cached. Defaults to ~/.nourishible-mcp/config.json
# NOURISHIBLE_MCP_CONFIG_DIR=~/.nourishible-mcp
