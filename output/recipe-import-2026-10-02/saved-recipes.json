    "steps": [
      {
        "text": "A — Ricky Cheung: Trim and halve the cherry tomatoes horizontally. Fry two eggs in a little oil until firm, season with salt and set aside.",
        "timestampSeconds": 223
      },
      {
        "text": "A: Beat two more eggs with salt; scramble over high heat until just set and set aside.",
        "timestampSeconds": 274
      },
      {
        "text": "A: Slowly cook the sliced onion in oil with a little salt until soft. Add stock and half the tomatoes; cover and cook over medium heat for 3 minutes.",
        "timestampSeconds": 354
      },
      {
        "text": "A: Quarter the fried eggs. Add these and the scrambled eggs to the tomato sauce with light soy sauce and Tabasco; cook over medium heat for 1 minute.",
        "timestampSeconds": 522
      },
      {
        "text": "A: Beat the remaining two eggs with salt and pour evenly over the sauce. Arrange the remaining tomatoes on top, season lightly, cover and cook over medium heat for 1 minute until set. Finish with scallions.",
        "timestampSeconds": 579
      },
      {
        "text": "B — Jacky Yu: Score the tomatoes, blanch for about 20 seconds, cool in ice water and peel. Divide between chunks and small dice.",
        "timestampSeconds": 844
      },
      {
        "text": "B: Beat five eggs with 1/2 tsp salt. Heat generous oil in a wok, slowly pour in the eggs and fry until fluffy and just set. Remove and drain.",
        "timestampSeconds": 994
      },
      {
        "text": "B: Fry minced garlic and ginger until fragrant. Add diced tomatoes, soften and mash into a sauce.",
        "timestampSeconds": 1067
      },
      {
        "text": "B: Add water or stock, tomato chunks, ketchup, tomato paste, sugar, sauce salt, light soy sauce and pepper. Simmer for about 3 minutes until soft.",
        "timestampSeconds": 1138
      },
      {
        "text": "B: Return the eggs and fold gently. Add a little cornstarch slurry only if needed to glaze the sauce. Finish with shallot oil and scallions.",
        "timestampSeconds": 1213
      }
