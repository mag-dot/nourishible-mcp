    ],
    "steps": [
      {
        "text": "Tear the cabbage into pieces, soak in lightly salted water for 10 minutes, then wash and drain thoroughly.",
        "timestampSeconds": 51
      },
      {
        "text": "Cut the pork belly into thick slices, then strips. Slice the green garlic stems and leaves separately; chop the scallion whites and mince the ginger and garlic.",
        "timestampSeconds": 73
      },
      {
        "text": "Heat a little oil in a wok. Add the pork belly and stir-fry over low heat for 2–3 minutes to render its fat, then remove the pork.",
        "timestampSeconds": 199
      },
      {
        "text": "Stir-fry the cabbage in the pork fat with a little salt until partly cooked and bright in color. Remove and set aside.",
        "timestampSeconds": 222
      },
      {
        "text": "Fry the scallion whites, ginger and garlic in the remaining oil. Add the pork belly and green garlic stems, then the soybean paste and a little dark soy sauce. Stir-fry until fragrant.",
        "timestampSeconds": 283
      },
      {
        "text": "Return the cabbage and toss until coated. Keep this final stir-fry within 2 minutes; add the green garlic leaves at the end, toss until cooked and serve.",
