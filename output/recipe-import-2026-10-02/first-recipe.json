  "steps": [
    {
      "text": "Peel the potato and cut it into small, even dice.",
      "timestampSeconds": 7
    },
    {
      "text": "Mix the potato with flour, cornstarch, a little oil and water until evenly coated in a batter.",
      "timestampSeconds": 21
    },
    {
      "text": "Fold in the corn kernels.",
      "timestampSeconds": 28
    },
    {
      "text": "Heat oil in a frying pan. Spoon in small portions of the mixture and flatten into thin fritters.",
      "timestampSeconds": 33
    },
    {
      "text": "Fry until the underside is golden, then flip and cook the other side until crisp and the potato is tender.",
      "timestampSeconds": 40
    },
    {
      "text": "Transfer to a wire rack to drain. Sprinkle with salt and aonori and serve.",
      "timestampSeconds": 46
    }
