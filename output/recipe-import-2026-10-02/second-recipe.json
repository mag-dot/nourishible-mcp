  "steps": [
    {
      "text": "Mix the light soy sauce, dark soy sauce, oyster sauce, pepper, sugar, Shaoxing wine and water into a sauce.",
      "timestampSeconds": 8
    },
    {
      "text": "Slice the egg tofu, pat dry and coat with cornstarch. Heat oil in a pan, fry both sides until golden, then set aside.",
      "timestampSeconds": 15
    },
    {
      "text": "Mince the garlic and fry until fragrant. Add some scallions, the minced pork and enoki mushrooms, and stir-fry until the pork is cooked.",
      "timestampSeconds": 26
    },
    {
      "text": "Return the tofu to the pan and pour in the sauce. Cover and simmer over low heat for 5 minutes until the sauce reduces.",
      "timestampSeconds": 44
    },
    {
      "text": "Sprinkle with the remaining scallions and serve.",
      "timestampSeconds": 50
    }
