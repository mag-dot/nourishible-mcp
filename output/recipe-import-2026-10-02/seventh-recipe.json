  "steps": [
    {
      "text": "Heat oil in a frying pan. Pan-fry the tofu squares until golden on both sides; set aside.",
      "timestampSeconds": 3
    },
    {
      "text": "Heat a little oil in a claypot. Fry the ginger strips, sliced shallots and red chili until fragrant.",
      "timestampSeconds": 12
    },
    {
      "text": "Add napa cabbage and stir. Add reduced-salt soy sauce, black vinegar and rice wine, then water. Cover and simmer until the cabbage begins to soften.",
      "timestampSeconds": 16
    },
    {
      "text": "Arrange the fried tofu on top. Cover again and simmer until the cabbage is tender and the tofu has absorbed the sauce.",
      "timestampSeconds": 33
    },
    {
      "text": "Season with white pepper. Stir in a little cornstarch slurry to lightly thicken the bubbling sauce.",
      "timestampSeconds": 40
    },
    {
      "text": "Scatter chopped scallions over the top and serve hot.",
      "timestampSeconds": 46
    }
